# Multi-stage build for App API
# Pin base image to digest for reproducible builds
FROM python:3.13-slim@sha256:739e7213785e88c0f702dcdc12c0973afcbd606dbf021a589cab77d6b00b579d AS builder

# Install uv (pinned to specific version for reproducibility)
COPY --from=ghcr.io/astral-sh/uv:0.7.12 /uv /uvx /bin/

# Set working directory
WORKDIR /app

# Compile every installed package to bytecode at build time. uv skips this by
# default, so the venv shipped with no .pyc files and every task that started
# from this image parsed the whole dependency tree (fastapi, boto3, strands,
# ...) on its first request. Unlike inference-api this is a long-lived ECS
# service, so the cost is paid per task start — deploys, scale-out, and Fargate
# task replacement — not per session. Unlike the Lambda images, appuser does own
# /app and so CAN write .pyc at runtime; that just means each new task pays the
# compile once and then throws the result away when it is replaced. Baking it
# into the image is what makes the work survive a task boundary.
ENV UV_COMPILE_BYTECODE=1

# Install system dependencies needed for any native builds
RUN apt-get update && apt-get install -y \
    gcc=4:14.2.0-1 \
    g++=4:14.2.0-1 \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files first (layer caching — deps change less often than code)
COPY backend/pyproject.toml backend/README.md ./
COPY backend/uv.lock ./

# Install dependencies only (not the project itself) from the locked versions
# --frozen: use the lock file as-is, no network resolution, pure replay
# --extra agentcore: include the agentcore optional dependency group (strands, etc.)
# --no-install-project: install deps only, skip the project package
# --no-dev: exclude development dependencies
# --no-editable: non-editable install for production
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --extra agentcore --no-install-project --no-dev --no-editable

# Copy source code and install the project itself
COPY backend/src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --extra agentcore --no-dev --no-editable

# Production stage
FROM python:3.13-slim@sha256:739e7213785e88c0f702dcdc12c0973afcbd606dbf021a589cab77d6b00b579d

WORKDIR /app

# Install runtime dependencies (curl required for HEALTHCHECK)
RUN apt-get update && apt-get install -y \
    curl=8.14.1-2+deb13u* \
    && rm -rf /var/lib/apt/lists/*

# Create the non-root user BEFORE the COPYs, so each one can land with the right
# ownership via --chown. This ordering is the whole point: a trailing
# `chown -R appuser:appuser /app` rewrites every file it touches into a fresh
# layer, so /app was shipped TWICE — once in the COPY layers and again in the
# chown layer (313MB of duplicate before this image carried bytecode, 454MB
# after). --chown moves the ownership into the COPY itself, which costs nothing.
RUN useradd -m -u 1000 -s /bin/bash appuser

# /app itself (created by WORKDIR as root) — a single non-recursive chown, so it
# stays a ~0-byte layer rather than a copy of the tree.
RUN chown appuser:appuser /app

# Copy the virtual environment from builder
COPY --from=builder --chown=appuser:appuser /app/.venv /app/.venv

# Copy application code. appuser MUST own this tree, not just be able to read
# it: main.py's lifespan resolves base_dir to Path(__file__).parent.parent —
# i.e. /app/src/apis, NOT /app — and os.makedirs() the output/uploads/
# generated_images directories there on every startup. Drop the ownership here
# and the service dies on a PermissionError at boot.
COPY --chown=appuser:appuser backend/src /app/src

# Create necessary directories. These are /app/*, which the base_dir above means
# nothing actually reads or writes today; kept (and kept appuser-owned, which
# the old recursive chown did implicitly) so this stays a pure layer change.
RUN install -d -o appuser -g appuser /app/output /app/uploads /app/generated_images

# Switch to non-root user
USER appuser

# Precompile our own source the same way the venv was (see UV_COMPILE_BYTECODE
# above). `-q` keeps the layer log quiet; a syntax error still fails the build,
# which is the right time to learn about it. Runs after USER so the .pyc land
# owned by appuser rather than root.
RUN python -m compileall -q /app/src

# Version injection (defaults to "unknown" if not provided via --build-arg)
ARG APP_VERSION=unknown
ENV APP_VERSION=${APP_VERSION}

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src
ENV PATH="/app/.venv/bin:$PATH"

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the application
CMD ["uvicorn", "apis.app_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
